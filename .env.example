# Copy to server/.env for local backend configuration.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/smart_parking
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Parkwise <no-reply@example.com>
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
